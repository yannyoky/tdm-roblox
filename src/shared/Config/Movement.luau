-- Передвижение пешком: бег, выносливость, перелезание и залезание на уступы.
-- Все расстояния в студах (1 студ ≈ 28 см). Рост персонажа ≈ 5 студов.
return {
	Sprint = {
		Multiplier = 1.5, -- во сколько раз бег быстрее шага (16 → 24)
		StaminaMax = 100,
		Drain = 0, -- расход в секунду при беге; 0 — бег бесконечный, полоска выносливости не появляется
		Regen = 20, -- восстановление в секунду
		RegenDelay = 1.2, -- пауза после бега до начала восстановления
		MinToStart = 15, -- сколько нужно, чтобы снова побежать после нуля
	},

	-- Прицеливание (правая кнопка мыши / L2) с оружием: идём медленнее, бег невозможен.
	-- Стрелять на бегу нельзя: нажатие на выстрел прерывает бег, выстрел — когда оружие поднято.
	Aim = {
		SpeedMultiplier = 0.55, -- доля обычной скорости при прицеливании (16 → ~9)
		FireAfterSprint = 0.2, -- секунд после бега до первого выстрела (оружие поднимается)
	},

	Parkour = {
		-- Всё срабатывает от прыжка (пробел или кнопка прыжка на телефоне) перед препятствием.
		ReachDistance = 3.2, -- как далеко перед собой ищем препятствие
		MinHeight = 1.6, -- ниже — обычная ступенька, Roblox перешагнёт сам
		VaultMaxHeight = 4.6, -- до этой высоты: перемахнуть (заборы, ящики, бетонные блоки)
		VaultMaxThickness = 4, -- толще — запрыгиваем сверху, а не перелетаем
		ClimbMaxHeight = 9.8, -- до этой высоты: подтянуться на уступ (контейнер 8.5, гараж 5–7, стены до 9)
		VaultTime = 0.35, -- секунд на перемах
		ClimbTime = 0.75, -- секунд на подтягивание
		ClimbStaminaCost = 0, -- сколько выносливости тратит подтягивание (0 — нисколько)
		Cooldown = 0.35,
	},
}
