-- Внешний вид персонажей: пропорции тела и анимации движения.
-- Одежду, лица и кастомизацию делает отдельная система (скины и кастомизация).

local Character = {}

-- Пропорции R15 (HumanoidDescription). 0 — классический «кубический» Roblox, 1 — реалистичные пропорции (Rthro).
-- Рост почти не меняем, чтобы укрытия, окна и двери на картах подходили по высоте.
Character.Body = {
	BodyTypeScale = 0.6,
	ProportionScale = 0.5,
	HeightScale = 1,
	WidthScale = 1,
	DepthScale = 1,
	HeadScale = 1,
}

-- Анимации ходьбы, бега, прыжков (официальный пакет Roblox «Rthro», реалистичнее стандартного).
-- id из документации Roblox: create.roblox.com/docs/animation/using. Пусто — стандартная анимация.
Character.Animations = {
	idle = { "2510197257", "2510196951" },
	walk = "2510202577",
	run = "2510198475",
	jump = "2510197830",
	fall = "2510195892",
	climb = "2510192778",
	swim = "2510199791",
	swimidle = "2510201162",
}

-- Живая пластика поверх анимаций (src/client/Locomotion.luau): инерция, крен в поворотах, приземление.
-- Углы в радианах (0.1 ≈ 6°), скорости в студах в секунду.
Character.Locomotion = {
	Enabled = true,
	MaxDistance = 150, -- дальше от камеры не считаем (не видно)
	Smooth = 7, -- скорость сглаживания наклонов (больше — резче)
	AccelLean = 0.004, -- наклон на единицу ускорения (разгон — вперёд, торможение — назад)
	MaxPitch = 0.12,
	SpeedLean = 0.07, -- постоянный наклон вперёд на скорости спринта
	SprintSpeed = 24,
	TurnLean = 0.0035, -- крен внутрь поворота: скорость поворота × скорость движения × это
	MaxRoll = 0.16,
	-- Приземление: от скорости падения LandMinSpeed (лёгкий прыжок) до LandMaxSpeed (с крыши).
	LandMinSpeed = 30,
	LandMaxSpeed = 90,
	LandKick = 34, -- сила просадки (пик ≈ LandKick / √LandStiffness × 0.5)
	LandMaxDrop = 1.0, -- максимум, на сколько опускается таз
	LandStiffness = 200, -- жёсткость пружины выпрямления
	LandDamping = 0.6, -- 1 — без отскока, меньше — с лёгким пружинящим отскоком
	-- Посадка в машину и выход: тело за EnterTime секунд переходит от двери к сиденью (и обратно),
	-- пригибаясь на EnterDuck студов посередине пути.
	EnterTime = 0.55,
	EnterDuck = 0.6,
}

return Character
