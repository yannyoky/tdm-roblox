-- Внешний вид персонажей: пропорции тела и анимации движения.
-- Одежду, лица и кастомизацию делает отдельная система (скины и кастомизация).

local Character = {}

-- Пропорции R15 (HumanoidDescription). 0 — классический «кубический» Roblox, 1 — реалистичные пропорции (Rthro).
-- Рост почти не меняем, чтобы укрытия, окна и двери на картах подходили по высоте.
Character.Body = {
	BodyTypeScale = 0.6,
	ProportionScale = 0.5,
	HeightScale = 1,
	WidthScale = 1,
	DepthScale = 1,
	HeadScale = 1,
}

-- Анимации ходьбы, бега, прыжков (официальный пакет Roblox «Rthro», реалистичнее стандартного).
-- id из документации Roblox: create.roblox.com/docs/animation/using. Пусто — стандартная анимация.
Character.Animations = {
	idle = { "2510197257", "2510196951" },
	walk = "2510202577",
	run = "2510198475",
	jump = "2510197830",
	fall = "2510195892",
	climb = "2510192778",
	swim = "2510199791",
	swimidle = "2510201162",
	sit = "2506281703", -- сидение (стандартное R15): скамейки, места в машине
}

-- Контроллер анимаций своего персонажа (src/client/AnimDirector.luau) вместо стандартного Animate:
-- покой/шаг/бег смешиваются весами по скорости, скорость проигрывания подогнана под движение.
Character.Director = {
	Enabled = true,
	MoveThreshold = 0.6, -- скорость (студ/с), с которой персонаж считается идущим
	StartRate = 7, -- как быстро покой переходит в движение (1/с)
	StopRate = 5, -- и обратно — чуть мягче, тело «дотормаживает»
	WalkNorm = 0.5, -- нормированная скорость, до которой играет только шаг (≈ 6.4 студ/с)
	RunNorm = 1, -- с которой играет только бег (≈ 12.8 студ/с)
	MinPlaySpeed = 0.35, -- шаг медленнее этого не замедляем (иначе «плывёт»)
	MaxPlaySpeed = 2.0, -- бег быстрее этого не ускоряем
	GroundFade = 0.25, -- переходы между покоем, шагом и бегом (с)
	LandFade = 0.18, -- после приземления
	SitFade = 0.35, -- сесть / встать
	Idle2Min = 9, -- раз в столько–столько секунд покоя играет вторая поза покоя
	Idle2Max = 18,
}

-- Живая пластика поверх анимаций (src/client/Locomotion.luau): инерция, крен в поворотах, приземление.
-- Углы в радианах (0.1 ≈ 6°), скорости в студах в секунду.
Character.Locomotion = {
	Enabled = true,
	MaxDistance = 150, -- дальше от камеры не считаем (не видно)
	Smooth = 7, -- скорость сглаживания наклонов (больше — резче)
	AccelLean = 0.004, -- наклон на единицу ускорения (разгон — вперёд, торможение — назад)
	MaxPitch = 0.12,
	SpeedLean = 0.07, -- постоянный наклон вперёд на скорости спринта
	SprintSpeed = 24,
	TurnLean = 0.0035, -- крен внутрь поворота: скорость поворота × скорость движения × это
	MaxRoll = 0.16,
	-- Приземление: от скорости падения LandMinSpeed (лёгкий прыжок) до LandMaxSpeed (с крыши).
	LandMinSpeed = 30,
	LandMaxSpeed = 90,
	LandKick = 34, -- сила просадки (пик ≈ LandKick / √LandStiffness × 0.5)
	LandMaxDrop = 1.0, -- максимум, на сколько опускается таз
	LandStiffness = 200, -- жёсткость пружины выпрямления
	LandDamping = 0.6, -- 1 — без отскока, меньше — с лёгким пружинящим отскоком
	-- Посадка в машину и выход: тело за EnterTime секунд переходит от двери к сиденью (и обратно),
	-- пригибаясь на EnterDuck студов посередине пути.
	EnterTime = 0.55,
	EnterDuck = 0.6,
	-- IK ног: стоя на ступеньках, бордюрах и склонах каждая ступня встаёт на свою высоту.
	FootIK = true,
	FootIKDistance = 70, -- дальше от камеры не считаем
	FootIKUp = 1.2, -- на сколько выше обычного уровня ищем землю под ступнёй
	FootIKDown = 1.4, -- и на сколько ниже (больше — таз не опускается)
	FootMaxTilt = 0.45, -- наибольший наклон стопы по склону (≈ 25°)
}

-- Живое тело поверх анимаций (src/client/BodyLife.luau): разворот бёдер, дыхание, взгляд, рука к предмету.
-- Углы в градусах там, где так подписано, остальное в радианах.
Character.Body = {
	Enabled = true,
	MaxDistance = 120, -- дальше от камеры не считаем
	MaxTwist = 1.05, -- наибольший разворот бёдер при движении вбок (≈ 60°)
	TwistRate = 8, -- как быстро бёдра доворачиваются по ходу
	SprintSpeed = 24,
	ExertionGain = 0.12, -- насколько быстро запыхается на бегу (в секунду)
	ExertionDecay = 0.07, -- и как быстро отдышится
	BreathPeriod = 4.2, -- вдох-выдох в покое (с)
	BreathPeriodTired = 1.5, -- после бега
	BreathAmp = 0.012, -- подъём груди (рад)
	BreathAmpTired = 0.035,
	MaxHeadYaw = 75, -- голова поворачивается в стороны до (градусы)
	MaxHeadUp = 35,
	MaxHeadDown = 45,
	LookBehind = 115, -- смотрит дальше этого угла за спину — голова возвращается вперёд
	LookAhead = 0.12, -- насколько голова «заглядывает» в поворот (с упреждения)
	HeadRate = 6, -- скорость поворота головы (1/с), меньше — плавнее и ленивее
	WaistShare = 0.25, -- доля взгляда, которую берёт корпус
	SocialRange = 14, -- боты и прохожие смотрят на игроков ближе этого
	ReachTime = 0.9, -- сколько секунд рука тянется к предмету после нажатия E
}

-- Персонаж в машине (src/client/DriverPose.luau): руки на руле, крен от перегрузок, взгляд в поворот.
Character.Driving = {
	Enabled = true,
	SteeringWheel = true, -- ставить руль перед водителем (у мешей машин своего нет)
	-- Где руль относительно верха сиденья водителя: X вправо, Y вверх, Z назад (вперёд — минус).
	WheelOffset = Vector3.new(0, 2.05, -1.85),
	WheelTilt = 22, -- наклон руля к водителю (градусы)
	WheelRadius = 0.72,
	WheelTurn = 110, -- на сколько градусов поворачивается руль при полном повороте
	HandsDelay = 0.45, -- через сколько секунд после посадки руки ложатся на руль
	LeanRoll = 0.006, -- крен корпуса на единицу бокового ускорения (наружу поворота)
	LeanPitch = 0.004, -- наклон назад при разгоне / вперёд при торможении
	MaxRoll = 0.22,
	MaxPitch = 0.15,
	HeadTurn = 0.4, -- на сколько голова водителя смотрит в поворот (рад при полном руле)
}

-- Мимика (src/client/FaceLife.luau): у динамических голов с FaceControls.
Character.Face = {
	Enabled = true,
	MaxDistance = 45, -- дальше лица не видно, не считаем
	BlinkMin = 2.0, -- моргает раз в столько–столько секунд
	BlinkMax = 5.5,
	BlinkTime = 0.16, -- длительность моргания
}

-- Камера от третьего лица в стиле GTA (src/client/FollowCamera.luau).
Character.Camera = {
	Enabled = true,
	Distance = 9, -- расстояние за спиной (колесо мыши меняет от MinDistance до MaxDistance)
	MinDistance = 4,
	MaxDistance = 16,
	Shoulder = 1.6, -- сдвиг вправо через плечо
	Height = 1.9, -- точка, на которую смотрит камера, над корнем персонажа
	AimDistance = 4.5, -- в прицеле (правая кнопка с оружием) камера ближе
	AimShoulder = 2.0,
	FollowRate = 10, -- как быстро камера догоняет персонажа по горизонтали (больше — жёстче)
	FollowRateY = 6, -- по вертикали (мягче: прыжки и ступеньки не дёргают кадр)
	ZoomRate = 6,
	CollisionRadius = 0.5,
	MinPitch = -70,
	MaxPitch = 60,
	TurnRate = 11, -- как быстро персонаж поворачивается к направлению движения (1/с)
	AimTurnRate = 25, -- и к прицелу, когда целится или стреляет
	Sway = 0.12, -- лёгкое «живое» покачивание камеры в покое (градусы), 0 — выкл.
	-- В машине: камера сзади, отстаёт в поворотах, сама возвращается за машину.
	CarDistance = 1.25, -- × длина машины + 6
	CarHeight = 3.5,
	CarPitch = -10, -- наклон камеры вниз в машине (градусы)
	CarRecenterDelay = 1.2, -- через сколько секунд без мыши камера возвращается за машину
	CarRecenterRate = 2.5,
}

return Character
