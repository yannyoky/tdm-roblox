-- Боты: добивают каждую команду до TeamSize и уходят, когда заходят живые игроки.
-- Все расстояния в студах, время в секундах.
return {
	Enabled = true,
	TeamSize = 4, -- сколько бойцов в команде вместе с ботами

	ThinkInterval = 0.15, -- как часто бот принимает решения (движение и прицел обновляются каждый кадр)

	-- Зрение и реакция
	ViewDistance = 160, -- дальше бот не видит
	FieldOfView = 140, -- угол обзора, градусов; за спиной замечает только вплотную
	BackSenseDistance = 18, -- врага за спиной ближе этого бот «чувствует»
	ReactionTime = 0.35, -- минимум от момента, как бот увидел врага, до первого выстрела
	ReactionRandom = 0.3, -- + случайная добавка к реакции
	ReactionPerStud = 0.002, -- + чем дальше враг, тем дольше реакция
	ReacquireTime = 0.12, -- реакция, если тот же враг снова показался в течение 1.5 с
	HearDistance = 90, -- слышит выстрелы врагов на этом расстоянии
	MemoryTime = 6, -- сколько помнит, где последний раз видел или слышал врага

	-- Прицел
	TurnResponsiveness = 18, -- как быстро поворачивается корпус (больше — резче)
	AimTracking = 9, -- как быстро прицел догоняет цель (больше — точнее по бегущим)
	AimError = 1.6, -- разброс прицела после того, как бот «пристрелялся»
	AimErrorStart = 2.5, -- во сколько раз разброс больше в первую секунду
	AimSettleTime = 0.9, -- за сколько разброс сходится к AimError
	HeadshotChance = 0.12, -- как часто целится в голову
	BurstShots = { 3, 7 }, -- длина очереди у автоматов
	BurstPause = { 0.2, 0.55 }, -- пауза между очередями
	SemiExtraDelay = { 0.08, 0.3 }, -- добавка к паузе между одиночными выстрелами

	-- Движение
	Steering = 7, -- плавность разгона и поворотов (меньше — плавнее, больше — резче)
	SprintMultiplier = 1.5, -- бег вне боя, как у игроков
	SprintStamina = 6, -- сколько секунд может бежать подряд
	CrouchSpeed = 8,

	-- Тактика
	CoverHealth = 0.5, -- ниже этой доли здоровья ищет укрытие
	CoverSearchRadius = 28,
	CoverCooldown = 8, -- не чаще одного укрытия за столько секунд
	CoverTime = { 2.5, 4.5 }, -- сколько сидит в укрытии
	FlankOffset = 35, -- насколько далеко в сторону бот заходит при охоте (у каждого свой)

	PrimaryWeapons = { "Rifle", "SMG", "Shotgun", "LMG" },

	Names = {
		"Ястреб", "Гром", "Кобра", "Шрам", "Волк", "Тень", "Буран", "Сокол",
		"Клык", "Штык", "Барс", "Седой", "Борзый", "Кедр", "Рысь", "Молот",
	},
}
