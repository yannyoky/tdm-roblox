-- Форма каждой машины по её модели: кузов из меша, колёса, коробки столкновений, сиденья, двери.
-- Меши из Creator Store: «Low-Poly Vehicle/Car Pack» (asset 93588406843965, Darkerio_Officiel)
-- и полицейская машина из «Low Poly Cars Pack» (asset 9127235869). Скрипты из паков не используются.
-- Размеры сняты с мешей в Studio (лучами по форме кузова), поэтому колёса стоят там же, где на модели.
--
-- Все координаты — от точки на земле под центром машины: X вправо, h — высота над землёй, Z назад
-- (перед машины — −Z).
--   size   -- габарит меша (X ширина с зеркалами, Y высота, Z длина)
--   parts  -- меши: pos относительно центра габарита, yaw — поворот вокруг вертикали (градусы)
--   wheels -- x: половина колеи (центр колеса), front/rear: Z осей, r: радиус, w: ширина шины
--   hull   -- невидимые коробки по форме кузова: min/max = (x, h, z). glass = стёкла: держат удар
--             о стену, но пропускают пули (можно стрелять из машины и попасть в сидящих)
--   seats  -- pos = (x, верх сиденья, z); первое — водитель. door: "back" — посадка сзади,
--             иначе со своей стороны. open = открытое место (кузов, платформа)
--   roof   -- где на крыше полоса цвета команды: h, z, len, w
--   siren  -- где мигалка (если у машины LightBar): h, z
--   lights -- фары: x (от центра), h, z (источник света). head / tail — где стекло фары и задний
--             фонарь, если не на месте по умолчанию: x, h, z, w × ht (размер стекла, ht — высота)
-- Чтобы подогнать коробки, включите ShowHull = true в Config/Vehicles.
local function v(x, y, z)
	return Vector3.new(x, y, z)
end

-- Симметричная коробка: половина ширины, высоты от/до, Z от/до.
local function box(halfX: number, h0: number, h1: number, z0: number, z1: number, glass: boolean?)
	return { min = v(-halfX, h0, z0), max = v(halfX, h1, z1), glass = glass }
end

-- Бортик (пара узких коробок по бокам), например стенки кузова пикапа.
local function walls(list, x0: number, x1: number, h0: number, h1: number, z0: number, z1: number)
	table.insert(list, { min = v(-x1, h0, z0), max = v(-x0, h1, z1) })
	table.insert(list, { min = v(x0, h0, z0), max = v(x1, h1, z1) })
	return list
end

